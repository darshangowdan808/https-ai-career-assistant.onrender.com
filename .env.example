# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/career_assistant?schema=public"

# Authentication
JWT_SECRET=your-secure-jwt-secret-here

# AI Service Keys (Optional - built-in intelligent heuristic engine works without key in clearly labeled demo mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Job Integration Keys (Optional - Arbeitnow public feed and verified Indian catalog work out of the box)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Interview and Scoring Config
PASSING_THRESHOLD=70
DEMO_MODE=true
